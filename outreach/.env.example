# Get your token at: https://www.producthunt.com/v2/oauth/applications
PRODUCT_HUNT_TOKEN=your_ph_api_key_here

# Get these at: https://developer.twitter.com — create a project, enable OAuth 2.0
# Set redirect URI to: http://localhost:8765/callback
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
